# Application Settings
PROJECT_NAME="TaskFlow API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# Security & JWT
# Note: Generate a strong secret key in production e.g. `openssl rand -hex 32`
SECRET_KEY="taskflow_super_secret_jwt_key_change_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="taskflow_user"
POSTGRES_PASSWORD="taskflow_password"
POSTGRES_DB="taskflow_db"
DATABASE_URL="postgresql+asyncpg://taskflow_user:taskflow_password@localhost:5432/taskflow_db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
